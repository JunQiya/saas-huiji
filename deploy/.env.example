# =============================================================================
# 星河·会记 生产环境变量模板 — 复制为 .env 放入 /opt/huiji 后按实际修改
#   cp deploy/.env.example /opt/huiji/.env && vi /opt/huiji/.env
# 权限: chmod 600 .env
# =============================================================================

# ---- 镜像(ACR) ----
# REGISTRY 用你的 ACR 专属域名(登录成功的那个), 如 crpi-dc4yah5a15psyda3.cn-hangzhou.personal.cr.aliyuncs.com
REGISTRY=crpi-dc4yah5a15psyda3.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=lxxno          # ACR 命名空间
IMAGE_TAG=latest             # 云效推 latest; 或用具体版本如 v20260819
# 镜像地址: ${REGISTRY}/${ACR_NAMESPACE}/huiji-server / huiji-gateway

# ---- 后端(必须) ----
# RDS 内网地址, 不要用公网; useSSL=true 需 RDS 开通 SSL 或改为 false
DB_URL=jdbc:mysql://<RDS_HOST>:3306/huiji?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=huiji_app
DB_PASSWORD=<RDS账号密码>
JWT_SECRET=<随机48位以上, 用 openssl rand -base64 48>

# ---- 域名(单域名 huiji.lxxno.cn: /官网 /admin后台 /h5会员端) ----
H5_DOMAIN=https://huiji.lxxno.cn/h5      # H5 前端路径(微信 OAuth/二维码回跳)
CORS_ORIGINS=https://huiji.lxxno.cn

# ---- 短信(生产) ----
SMS_DEV_MODE=false
SMS_FIXED_CODE=

# ---- 数据库连接池(可选, 默认 6/2) ----
HIKARI_POOL_SIZE=6
HIKARI_MIN_IDLE=2

# ---- 端口映射(ECS 上容器对外端口) ----
GATEWAY_PORT=80              # 统一网关对外端口(默认 80, 需要 https 时经 SLB/宿主 nginx 转发)
